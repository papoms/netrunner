#!/usr/bin/env python3
"""Serves the release build from bin/build-3d-client for use on jinteki.net.

    bin/serve-3d-client [port]        (default port 8000)

  /js/*, /css/*   from resources/release-3d/  (this branch's client)
  everything else from resources/public/      (images such as playmats, fonts
                                               referenced by the stylesheet)

Sends CORS headers, so the 3D board (WebGL) may load images from here, e.g. a
playmat at http://localhost:8000/img/playmats/<file>. A browser extension such
as Requestly redirects jinteki.net's /js/* and /css/netrunner.css here.
"""
import http.server
import os
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RELEASE = os.path.join(ROOT, "resources", "release-3d")
PUBLIC = os.path.join(ROOT, "resources", "public")


class Handler(http.server.SimpleHTTPRequestHandler):
    def translate_path(self, path):
        clean = path.split("?", 1)[0].split("#", 1)[0]
        base = RELEASE if clean.startswith(("/js/", "/css/")) else PUBLIC
        self.directory = base
        return super().translate_path(path)

    def end_headers(self):
        self.send_header("Access-Control-Allow-Origin", "*")
        # always fetch the newest build
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def log_message(self, fmt, *args):
        sys.stderr.write("%s\n" % (fmt % args))


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 8000
    if not os.path.exists(os.path.join(RELEASE, "js", "main.js")):
        sys.exit("No build yet: run bin/build-3d-client first.")
    print(f"Serving the 3D client on http://localhost:{port} (Ctrl+C to stop)")
    http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler).serve_forever()
